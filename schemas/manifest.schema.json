{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hawkstore.dev/schemas/manifest.schema.json",
  "title": "Hawkstore package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "author", "description", "categories", "game", "bepInEx", "plugin", "owners"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "github"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "github": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" }
      }
    },
    "owners": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versions"],
      "properties": {
        "id": { "const": "ravenfield" },
        "versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "bepInEx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": { "version": { "type": "string", "minLength": 1 } }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guid", "installDirectory", "entryDll"],
      "properties": {
        "guid": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$" },
        "installDirectory": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "entryDll": { "type": "string", "pattern": "^[^/\\\\]+\\.dll$" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": { "id": { "type": "string" }, "version": { "type": "string" } }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "format": "uri" },
        "issues": { "type": "string", "format": "uri" },
        "homepage": { "type": "string", "format": "uri" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downloadUrl", "sha256", "size", "publishedAt"],
      "properties": {
        "downloadUrl": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
